+@app.route("/products/<int:product_id>/batch-yield", methods=["POST"])
+@login_required
+def set_batch_yield(product_id):
+    """Sets "one batch of this recipe makes N pieces" for a product. This is
+    what turns ingredient amounts (entered as a total used in one batch)
+    into a per-piece cost — the same idea as "1kg of flour makes 20
+    breads", just set once per recipe instead of re-typed per ingredient.
+
+    If the recipe already had a batch size and existing ingredients, changing
+    it recalculates every ingredient's per-piece cost from its stored batch
+    total, so she can correct a batch size later ("actually this made 25,
+    not 30") without re-entering every ingredient. If this is the *first*
+    time a batch size is set on a recipe that already has ingredients (from
+    the old direct-per-piece entry style), we deliberately skip that
+    recalculation — those stored amounts were entered as per-piece values,
+    not batch totals, so dividing them by a batch size would corrupt them.
+    She's told to re-check those ingredients instead."""
+    db = get_db()
+    try:
+        new_yield = float(request.form.get("batch_yield_count") or 0)
+    except ValueError:
+        new_yield = 0
+
+    if new_yield <= 0:
+        flash(g.t("flash_batch_yield_invalid"), "error")
+        return redirect(url_for("products", open=product_id))
+
+    product = db.execute("SELECT batch_yield_count FROM products WHERE id = ?", (product_id,)).fetchone()
+    had_batch_yield_before = bool(product and product["batch_yield_count"] and product["batch_yield_count"] > 0)
+
+    db.execute("UPDATE products SET batch_yield_count = ? WHERE id = ?", (new_yield, product_id))
+
+    if had_batch_yield_before:
+        recipe_rows = db.execute(
+            "SELECT id, batch_qty FROM product_ingredients WHERE product_id = ?", (product_id,)
+        ).fetchall()
+        for row in recipe_rows:
+            db.execute(
+                "UPDATE product_ingredients SET yield_count = ?, quantity_per_unit = ? WHERE id = ?",
+                (new_yield, row["batch_qty"] / new_yield, row["id"]),
+            )
+        flash(g.t("flash_batch_yield_updated"), "success")
+    else:
+        existing_ingredients = db.execute(
+            "SELECT COUNT(*) as c FROM product_ingredients WHERE product_id = ?", (product_id,)
+        ).fetchone()["c"]
+        if existing_ingredients:
+            flash(g.t("flash_batch_yield_set_recheck"), "success")
+        else:
+            flash(g.t("flash_batch_yield_set"), "success")
+
+    db.commit()
+    return redirect(url_for("products", open=product_id))
+
+
