+@app.template_filter("money")
+def format_money(value):
+    """Formats a USD amount for display. Per-unit ingredient costs are often
+    genuinely tiny (a gram of salt, a single egg) — rounding those to 2
+    decimals like a normal price would silently show "$0.00" for a real,
+    nonzero cost, making it look like the price never saved. Below 1 cent,
+    show enough decimals to keep the actual value visible instead."""
+    try:
+        value = float(value)
+    except (TypeError, ValueError):
+        return "0.00"
+    if value != 0 and abs(value) < 0.01:
+        return f"{value:.4f}"
+    return f"{value:.2f}"
+
+
 def riel_to_usd(riel):
